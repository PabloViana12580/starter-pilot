# Copy to .env and fill in real values. Never commit .env.
# Server-side settings only; never expose them to frontend code.

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Local development only. Leave unset (off) in production.
DJANGO_DEBUG=true
# Production: the public host names and https origins of the site. Platforms
# listed in config/platforms.py (Render, Railway, Fly.io, Azure App Service)
# are added automatically; set these for any other host or a custom domain.
# DJANGO_ALLOWED_HOSTS=www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com
# Reverse proxies in front of the app that append to X-Forwarded-For (most
# platforms: 1). Used for login lockout and rate limits.
# DJANGO_TRUSTED_PROXY_COUNT=1
# Header a TLS-terminating proxy sets; "off" when nothing sits in front.
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# Path of the staff administration.
# DJANGO_ADMIN_URL=admin/
# DJANGO_TIME_ZONE=America/Chicago
# DJANGO_LANGUAGE_CODE=en

# --- Database: any PostgreSQL ---
# Supabase: Dashboard > Connect > Session pooler > URI (port 5432), with your
# database password filled in. Not the direct db.<ref>.supabase.co host
# (IPv6-only) and not the transaction pooler (port 6543).
# Neon/Aiven/Render/others: the connection URI they show, with sslmode=require.
# Local server: postgresql://user:password@localhost:5432/dbname?sslmode=disable
# URL-encode special characters in the password (@ -> %40, / -> %2F, # -> %23).
DATABASE_URL=
# Alternatively, leave DATABASE_URL empty and use:
# DB_HOST=  DB_PORT=5432  DB_NAME=  DB_USER=  DB_PASSWORD=
# TLS: require (default), verify-ca, or verify-full (+ DB_SSLROOTCERT=/path/ca.crt).
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# --- Site identity (shown on every page) ---
SITE_NAME="Starter Pilot"
SITE_TAGLINE="A throwaway project that tests the django-starter skill"
# Public base URL for links in emails, without a trailing slash.
SITE_URL=http://127.0.0.1:8000
SITE_EMAIL=hello@example.com
# SITE_PHONE=+1 555 010 0199
# SITE_ADDRESS=City, Region
# SITE_HOURS=Monday to Friday, 9 am to 5 pm

# --- Email (printed to the console until EMAIL_HOST is set) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Site Name <no-reply@example.com>

# --- Security ---
# Two-factor login for staff (default: on when a module stores personal data).
# STAFF_MFA_REQUIRED=true
# PASSWORD_MIN_LENGTH=12
# LOGIN_FAILURE_LIMIT=5
# LOGIN_LOCKOUT_MINUTES=15
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# LOG_LEVEL=INFO

# --- Business modules ---
# CRM: who receives an email for each website message (comma-separated; defaults to SITE_EMAIL).
# CRM_NOTIFY_EMAILS=owner@example.com
